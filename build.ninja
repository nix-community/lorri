builddir = .ninja

build all : phony .github/workflows/ci.json

# show the graph of ninja build dependencies in zathura
rule show-ninja-deps
  command = ninja -t graph | dot -Tpdf | zathura -

build show-ninja-deps: show-ninja-deps | build.ninja

# run all checks as would be run on CI
rule run-ci-checks
  command = execlineb -c "nix-run { $in -A ci.testsuite }"

build run-ci-checks : run-ci-checks ./shell.nix
  pool = console

# create the ci.json file for github actions
rule build-ci-files
  command = go run ./cmd/ci

build .github/workflows/ci.json : build-ci-files ./cmd/ci/main.go
