builddir = .ninja

build all : phony .github/workflows/ci.yml

# show the graph of ninja build dependencies in zathura
rule show-ninja-deps
  command = ninja -t graph | dot -Tpdf | zathura -

build show-ninja-deps: show-ninja-deps | build.ninja

# run all checks as would be run on CI
rule run-ci-checks
  command = go run ./cmd/ci test

build run-ci-checks : run-ci-checks ./cmd/ci/main.go
  pool = console

# create the ci.yml file for github actions
rule build-ci-files
  command = go run ./cmd/ci

build .github/workflows/ci.yml : build-ci-files ./cmd/ci/main.go
